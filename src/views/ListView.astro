---
/* 列表页：镇街 / 村落 / 地名与姓氏三个板块。
   筛选、查找与分页都在已生成的页面上跑，靠 data-* 属性与 kit 的 client/filter.js，
   不生成第二份数据文件。本站没有时间轴，筛选组比另两个分站多：
   单元类型、所属镇街、传统村落名录批次、姓氏各成一组，填了才出现。 */
import Base from 'lishui-kit/astro/layouts/Base.astro';
import PageHead from 'lishui-kit/astro/PageHead.astro';
import FilterForm from 'lishui-kit/astro/FilterForm.astro';
import CardGrid from 'lishui-kit/astro/CardGrid.astro';
import Pagination from 'lishui-kit/astro/Pagination.astro';
import { sectionPath } from 'lishui-kit/i18n/paths.mjs';
import { ctxFor } from '../site/context.mjs';
import { siteContent, ofSection, byTitle, sortFilterValues } from '../site/content.mjs';
import { CATEGORIES, SECTIONS, LIST_PAGE_SIZE } from '../site/config.mjs';

const { lang, section } = Astro.props;
const ctx = ctxFor(lang);
const content = siteContent();
const { ui } = ctx;

const text = SECTIONS[section][lang];
const entries = ofSection(content.entries, lang, section).sort(byTitle);
const homePath = sectionPath('home', lang);

const uniq = (fn) => [...new Set(entries.map(fn).filter(Boolean))];
const cats = sortFilterValues(uniq((e) => e.category), 'category', content);
const unitTypes = sortFilterValues(uniq((e) => e.unit_type), 'unittype', content);
const genres = sortFilterValues(uniq((e) => e.genre), 'genre', content);
const towns = sortFilterValues(uniq((e) => e.town), 'town', content);
const villageBatches = sortFilterValues(uniq((e) => e.village_batch), 'village', content);
const surnames = sortFilterValues([...new Set(entries.flatMap((e) => e.surnames || []))], 'surname', content);
const tags = sortFilterValues([...new Set(entries.flatMap((e) => e.tags || []))], 'tag', content);

const catNameOf = (key) => ctx.catName(CATEGORIES.find((c) => c.key === key));
const townLabelOf = (id) => content.byId.get(id)?.[lang]?.title || id;
const option = (value, label) => ({ value, label });

/* 取值一律用内容库的原始取值（data-filter="组:值"），界面文字在这里译好；
   英文页的标签走 gloss() 与 terms 词表，不让中文漏出。 */
const groups = entries.length > 0 ? [
  { key: 'category', label: ui.list.filterCategory, options: cats.map((v) => option(v, catNameOf(v))) },
  { key: 'unittype', label: ui.list.filterUnitType, options: unitTypes.map((v) => option(v, ctx.enumLabel('unitType', v))) },
  { key: 'genre', label: ui.list.filterGenre, options: genres.map((v) => option(v, ctx.enumLabel('genre', v))) },
  { key: 'town', label: ui.list.filterTown, options: towns.map((v) => option(v, townLabelOf(v))) },
  { key: 'village', label: ui.list.filterVillage, options: villageBatches.map((v) => option(v, ctx.batchLabel(v))) },
  { key: 'surname', label: ui.list.filterSurname, options: surnames.map((v) => option(v, v)) },
  { key: 'tag', label: ui.list.filterTag, options: tags.map((v) => option(v, ctx.tagLabel(v))) },
].filter((group) => group.options.length > 0) : [];

const updated = entries.map((e) => e.updated).filter(Boolean).sort().pop() || '';
const meta = [
  { label: ui.stats.entries, value: entries.length },
  ...(updated ? [{ label: ui.footer.updated, value: updated }] : []),
];
const path = sectionPath(section, lang);
---

<Base
  ctx={ctx}
  lang={lang}
  path={path}
  title={text.title}
  description={text.lede}
  active={section}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: text.title,
    description: text.lede,
    inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
    url: `${ctx.site.origin}${path}`,
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${ctx.site.origin}/#website`,
      name: lang === 'zh' ? ctx.site.name : ctx.site.nameEn,
      url: `${ctx.site.origin}${homePath}`,
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${ctx.site.portal}/#website`,
        name: lang === 'zh' ? ctx.site.portalName : ctx.site.portalNameEn,
        url: `${ctx.site.portal}${lang === 'en' ? '/en/' : '/'}`,
      },
    },
    hasPart: entries.map((entry) => ({
      '@type': entry.type === 'place' ? 'Place' : 'CreativeWork',
      name: entry.title,
      url: `${ctx.site.origin}${entry.path}`,
    })),
  }}
>
  <PageHead
    eyebrow={ui.nav[section]}
    title={text.title}
    lede={text.lede}
    note={text.note}
    meta={meta}
  />

  <section class="section">
    <div class="wrap">
      {groups.length > 0 && <FilterForm ui={ui} groups={groups} />}
      <CardGrid entries={entries} ctx={ctx} noresult={ui.list.noresult} empty={ui.list.empty} />
      {entries.length > LIST_PAGE_SIZE && <Pagination ui={ui} pageSize={LIST_PAGE_SIZE} />}
    </div>
  </section>
</Base>
