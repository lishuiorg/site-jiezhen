---
/* 关于页：内容范围、来源策略、已知缺口、许可、双语与主题、纠错、门禁、技术说明、当前规模。
   规模数字由构建时统计，不手工维护。 */
import Base from '../layouts/Base.astro';
import PageHead from 'lishui-kit/astro/PageHead.astro';
import StatBar from 'lishui-kit/astro/StatBar.astro';
import SectionHead from 'lishui-kit/astro/SectionHead.astro';
import { sectionPath } from 'lishui-kit/i18n/paths.mjs';
import { forLang } from 'lishui-kit';
import { ctxFor } from '../site/context.mjs';
import { siteContent, statsOf, ofSection } from '../site/content.mjs';
import { CATEGORIES, ARCHIVE, TYPE_DIRS } from '../site/config.mjs';

const { lang } = Astro.props;
const ctx = ctxFor(lang);
const content = siteContent();
const { ui } = ctx;
const a = ui.about;

const list = forLang(content.entries, lang);
const stats = statsOf(content, lang);

const statItems = ['entries', 'categories', 'unitTypes', 'sources']
  .map((key) => ({ label: ui.stats[key], value: stats[key] }));

const rightsRows = Object.keys(ui.rights)
  .filter((rights) => rights !== 'unknown')
  .map((rights) => [ctx.rightsLabel(rights), content.sourcesAll.filter((s) => s.rights === rights).length])
  .filter(([, n]) => n > 0);

const archiveRows = Object.entries(ARCHIVE[lang])
  .map(([key, label]) => [label, content.sourcesAll.filter((s) => s.archive === key).length])
  .filter(([, n]) => n > 0);

const sectionRows = Object.keys(TYPE_DIRS).map((dir) => [
  ui.nav[dir], ofSection(content.entries, lang, dir).length,
]);

const catRows = CATEGORIES
  .map((cat) => [ctx.catName(cat), list.filter((e) => e.category === cat.key).length])
  .filter(([, n]) => n > 0);

const tables = [
  { title: a.sectionsTitle, head: [a.sectionsHead, ui.stats.entries], rows: sectionRows },
  { title: a.catStatsTitle, head: [a.categoriesHead, ui.stats.entries], rows: catRows },
  { title: a.rightsTitle, head: [a.rightsHead, ui.stats.sources], rows: rightsRows },
  { title: a.archiveTitle, head: [a.archiveHead, ui.stats.sources], rows: archiveRows },
];
---

<Base
  lang={lang}
  path={sectionPath('about', lang)}
  title={a.title}
  description={a.lede}
  active="about"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: a.title,
    description: a.lede,
    inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
    url: `${ctx.site.origin}${sectionPath('about', lang)}`,
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${ctx.site.origin}/#website`,
      name: lang === 'zh' ? ctx.site.name : ctx.site.nameEn,
      url: `${ctx.site.origin}${sectionPath('home', lang)}`,
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${ctx.site.portal}/#website`,
        name: lang === 'zh' ? ctx.site.portalName : ctx.site.portalNameEn,
        url: `${ctx.site.portal}${lang === 'en' ? '/en/' : '/'}`,
      },
    },
  }}
>
  <PageHead
    eyebrow={ui.nav.about}
    title={a.title}
    lede={a.lede}
    meta={[
      { label: ctx.site.host },
      { label: lang === 'zh' ? ctx.site.portalName : ctx.site.portalNameEn, href: `${ctx.site.portal}${lang === 'en' ? '/en/' : '/'}` },
    ]}
  />

  <section class="section">
    <div class="wrap about__grid">
      <div class="prose">
        <h2>{a.scopeTitle}</h2>
        <p>{a.scopeBody}</p>
        <h2>{a.sourceTitle}</h2>
        <p>{a.sourceBody}</p>
        <h2>{a.gapTitle}</h2>
        <p>{a.gapBody}</p>
        <h2>{a.gateTitle}</h2>
        <p>{a.gateBody}</p>
      </div>
      <div class="prose">
        <h2>{a.licenseTitle}</h2>
        <p>{a.licenseBody}</p>
        <h2>{a.bilingualTitle}</h2>
        <p>{a.bilingualBody}</p>
        <h2>{a.fixTitle}</h2>
        <p>{a.fixBody}</p>
        <h2>{a.techTitle}</h2>
        <p>{a.techBody}</p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <SectionHead eyebrow="Numbers" title={a.statsTitle} note={a.statsNote} />
      <StatBar items={statItems} />
      <div class="prose">
        {tables.map((table) => (
          <>
            <h2>{table.title}</h2>
            <table>
              <thead>
                <tr><th>{table.head[0]}</th><th>{table.head[1]}</th></tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr><td>{row[0]}</td><td>{row[1]}</td></tr>
                ))}
              </tbody>
            </table>
          </>
        ))}
      </div>
    </div>
  </section>
</Base>
